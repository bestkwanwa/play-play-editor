# Block direct commits to main/develop branches
branch=$(git branch --show-current)
if [ "$branch" = "main" ] || [ "$branch" = "develop" ]; then
  echo ""
  echo "⛔ BLOCKED: Direct commits to '$branch' are not allowed!"
  echo ""
  echo "This project uses Git Flow. Please:"
  echo "  1. Create a feature branch: git checkout -b feature/phase-{N}-{description}"
  echo "  2. Make your changes there"
  echo "  3. Merge back with: git merge --no-ff"
  echo ""
  echo "📖 See: dev/learning/git-workflow/GIT_WORKFLOW.md"
  echo ""
  exit 1
fi

npx lint-staged
