{
    "version": "1.0",
    "description": "Skill activation triggers for play-play-editor project. Controls when skills automatically suggest or block actions.",
    "skills": {
        "skill-developer": {
            "type": "domain",
            "enforcement": "suggest",
            "priority": "high",
            "description": "Meta-skill for creating and managing Claude Code skills",
            "promptTriggers": {
                "keywords": [
                    "skill system",
                    "create skill",
                    "add skill",
                    "skill triggers",
                    "skill rules",
                    "hook system",
                    "skill development",
                    "skill-rules.json"
                ],
                "intentPatterns": [
                    "(how do|how does|explain).*?skill",
                    "(create|add|modify|build).*?skill",
                    "skill.*?(work|trigger|activate|system)"
                ]
            }
        },
        "learning-documentation": {
            "type": "domain",
            "enforcement": "suggest",
            "priority": "medium",
            "description": "Guidelines for documenting learning conversations and Q&A sessions",
            "promptTriggers": {
                "keywords": [
                    "save conversation",
                    "record conversation",
                    "document conversation",
                    "save qa",
                    "save q&a",
                    "learning notes",
                    "记录对话",
                    "保存对话",
                    "学习笔记"
                ],
                "intentPatterns": [
                    "(save|record|document|capture).*?(conversation|discussion|qa|q&a)",
                    "(how to|how do I).*?(save|record|document).*?(conversation|learning)",
                    "记录.*?对话",
                    "保存.*?(对话|笔记)"
                ]
            }
        },
        "project-todo-manager": {
            "type": "domain",
            "enforcement": "suggest",
            "priority": "high",
            "description": "Manages TODO.md synchronization with dev docs and project progress tracking",
            "promptTriggers": {
                "keywords": [
                    "update todo",
                    "sync todo",
                    "更新待办",
                    "同步进度",
                    "mark complete",
                    "mark done",
                    "完成任务",
                    "标记完成",
                    "phase complete",
                    "sprint complete",
                    "phase done",
                    "sprint done",
                    "完成阶段",
                    "阶段完成"
                ],
                "intentPatterns": [
                    "(update|sync|maintain).*?(todo|progress|tasks)",
                    "(mark|set).*?(complete|done|finished)",
                    "完成.*?(任务|功能)",
                    "更新.*?(待办|进度)",
                    "(phase|sprint).*?(complete|done|finished)",
                    "完成.*?阶段"
                ]
            },
            "fileTriggers": {
                "paths": [
                    "dev/active/**/*.md",
                    "dev/TODO.md"
                ]
            }
        },
        "git-workflow-assistant": {
            "type": "guardrail",
            "enforcement": "block",
            "priority": "critical",
            "description": "Enforces Git Flow + Phase naming workflow, automates branch operations, and guides developers",
            "promptTriggers": {
                "keywords": [
                    "start phase",
                    "begin phase",
                    "finish phase",
                    "complete phase",
                    "开始阶段",
                    "完成阶段",
                    "create branch",
                    "new branch",
                    "merge branch",
                    "git checkout",
                    "git merge",
                    "git commit",
                    "git push",
                    "release phase",
                    "hotfix",
                    "紧急修复"
                ],
                "intentPatterns": [
                    "(start|begin|create|开始).*?(phase|阶段)",
                    "(finish|complete|done|完成).*?(phase|阶段)",
                    "(create|make|new).*?branch",
                    "(merge|integrate).*?branch",
                    "checkout.*?(main|master)",
                    "commit.*?(main|master|develop)",
                    "(hotfix|emergency|紧急).*?(fix|bug|修复)",
                    "release.*?phase"
                ]
            },
            "gitCommandTriggers": {
                "description": "Monitor for dangerous Git operations",
                "patterns": [
                    "git checkout (main|master)",
                    "git commit.*?(main|master|develop)",
                    "git push.*?--force",
                    "git checkout -b (?!feature/phase-)",
                    "git merge (?!.*--no-ff)",
                    "git branch -[dD] (main|master|develop)"
                ]
            }
        },
        "css-debugger": {
            "type": "domain",
            "enforcement": "suggest",
            "priority": "high",
            "description": "Enforces systematic CSS debugging workflow for all styling issues (layout, visual, typography, spacing, animations, responsive, stacking, overflow)",
            "promptTriggers": {
                "keywords": [
                    "css",
                    "styling",
                    "style",
                    "layout",
                    "height",
                    "width",
                    "padding",
                    "margin",
                    "color",
                    "font",
                    "animation",
                    "transition",
                    "responsive",
                    "z-index",
                    "overflow",
                    "样式",
                    "布局",
                    "高度",
                    "宽度",
                    "边距",
                    "颜色",
                    "字体",
                    "动画",
                    "响应式"
                ],
                "intentPatterns": [
                    "(css|style|styling).*?(not working|issue|problem|broken|wrong)",
                    "(height|width|layout|padding|margin).*?(not working|issue|problem|incorrect)",
                    "(color|font|animation|transition).*?(not working|issue|problem)",
                    "fix.*?(css|style|styling|layout|height|width)",
                    "样式.*?(问题|错误|不对)",
                    "布局.*?(问题|错误|不对)",
                    "(高度|宽度).*?(不对|错误|没有)"
                ]
            }
        }
    },
    "notes": {
        "enforcement_types": {
            "suggest": "Skill suggestion appears but doesn't block execution",
            "block": "Requires skill to be used before proceeding (guardrail)",
            "warn": "Shows warning but allows proceeding"
        },
        "priority_levels": {
            "critical": "Highest - Always trigger when matched",
            "high": "Important - Trigger for most matches",
            "medium": "Moderate - Trigger for clear matches",
            "low": "Optional - Trigger only for explicit matches"
        },
        "customization": {
            "next_steps": "As you define your editor architecture, create custom skills for:",
            "suggestions": [
                "Editor core patterns (canvas, rendering, state management)",
                "Component architecture specific to your editor",
                "React patterns you want to enforce",
                "Testing strategies for editor functionality"
            ]
        }
    }
}
